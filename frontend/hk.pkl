amends "package://github.com/jdx/hk/releases/download/v2.10.0/hk@2.10.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.10.0/hk@2.10.0#/Builtins.pkl"

local code = List("**/*.{js,mjs,ts,svelte,css,json}", "pnpm-lock.yaml", "pnpm-workspace.yaml", "patches/*.patch", "mise.toml")

steps {
  ["eslint"] = (Builtins.eslint) {
    glob = List("**/*.{js,mjs,ts,svelte}")
    check = "eslint --no-warn-ignored --max-warnings=0 {{files}}"
    fix = "eslint --fix --no-warn-ignored --max-warnings=0 {{files}}"
    depends = "frontend-dependencies"
  }
  ["stylelint"] = (Builtins.stylelint) {
    glob = List("**/*.{css,svelte}")
    check = "stylelint --max-warnings=0 --allow-empty-input {{files}}"
    fix = "stylelint --fix --max-warnings=0 --allow-empty-input {{files}}"
    depends = "frontend-dependencies"
  }
  ["types"] {
    glob = code
    check = "pnpm check"
    depends = "frontend-dependencies"
  }
  ["unit-tests"] {
    glob = code
    check = "pnpm test:unit"
    depends = "frontend-dependencies"
  }
  ["mise-format"] = Builtins.mise
}
