{
	"name": "frontend",
	"version": "1.6.0",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"openapi-ts": "openapi-ts",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit --project src/service-worker/tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest run --project server",
		"test:component": "vitest run --project client",
		"test:integration": "vitest run --project integration",
		"test": "vitest run --project server --project client",
		"prepare": "svelte-kit sync || echo ''",
		"test:e2e": "playwright test",
		"test:install": "playwright install chromium firefox"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@hey-api/openapi-ts": "0.99.0",
		"@ianvs/prettier-plugin-sort-imports": "4.7.1",
		"@playwright/test": "1.64.0",
		"@sveltejs/adapter-node": "6.0.0",
		"@sveltejs/enhanced-img": "1.0.0",
		"@sveltejs/kit": "3.0.1",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/forms": "0.5.11",
		"@tailwindcss/vite": "4.3.3",
		"@types/d3-scale": "4.0.9",
		"@types/d3-shape": "3.2.0",
		"@types/d3-time": "3.0.4",
		"@types/node": "26.6.4",
		"@vitest/browser-playwright": "5.0.3",
		"eslint": "10.12.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.23.0",
		"globals": "17.13.0",
		"maplibre-gl": "6.13.0",
		"playwright": "1.64.0",
		"prettier": "3.9.9",
		"prettier-plugin-svelte": "4.1.1",
		"prettier-plugin-tailwindcss": "0.8.1",
		"svelte": "5.57.2",
		"svelte-check": "4.7.6",
		"svelte-maplibre-gl": "2.2.1",
		"tailwindcss": "4.3.3",
		"typescript": "6.0.3",
		"typescript-eslint": "8.71.1",
		"vite": "8.3.3",
		"vitest": "5.0.3",
		"vitest-browser-svelte": "3.1.0"
	},
	"dependencies": {
		"@deck.gl/core": "9.4.0",
		"@deck.gl/layers": "9.4.0",
		"@deck.gl/maplibre": "9.4.0",
		"@fontsource/inter": "^5.2.8",
		"@lucide/svelte": "^1.51.0",
		"apache-arrow": "21.2.0",
		"d3-scale": "^4.0.2",
		"d3-shape": "^3.2.0",
		"d3-time": "^3.1.0",
		"dayjs": "^1.11.20",
		"flexsearch": "^0.8.212",
		"layercake": "^11.0.0",
		"runed": "^0.37.1"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
