amends "package://github.com/jdx/hk/releases/download/v2.11.1/hk@2.11.1#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.11.1/hk@2.11.1#/Builtins.pkl"

subprojects = List("frontend", "backend", "science")
exclude = List("**/CHANGELOG.md", "frontend/src/lib/client/**")

steps {
  ["trailing-whitespace"] = (Builtins.trailing_whitespace) {
    // Unified diff context lines can consist of a single significant space.
    exclude = List("backend/tests/fixtures/**", "frontend/patches/**")
  }
  ["newlines"] = (Builtins.newlines) {
    exclude = List("backend/tests/fixtures/**")
  }
  ["merge-conflict"] = Builtins.check_merge_conflict
  ["mise-format"] = Builtins.mise
  ["mise-lock"] {
    glob = List("mise.toml", "mise.lock", "**/mise.toml", ".mise/locks/**")
    fix = "mise lock && git diff --exit-code -- mise.lock .mise/locks"
    exclusive = true
  }
  ["frontend-dependencies"] {
    glob = Builtins.prettier.glob + List("frontend/patches/*.patch", "frontend/mise.toml")
    exclude = List("backend/tests/fixtures/**")
    check = "mise run //frontend:pnpm-install"
  }
  ["prettier"] = (Builtins.prettier) {
    exclude = List("**/pnpm-lock.yaml", "backend/tests/fixtures/**")
    depends = "frontend-dependencies"
  }
}

hooks {
  ["pre-commit"] {
    fix = true
    stage = false
    fail_on_fix = true
    stash = "git"
  }
}
