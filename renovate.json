{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "schedule": ["* * * * 1"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* * 1-7 * 1"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track the Node.js runtime in Dockerfiles",
      "managerFilePatterns": ["/(^|/)Dockerfile$/"],
      "matchStrings": [
        "# renovate: datasource=node-version depName=node\\s+RUN pnpm runtime set node (?<currentValue>\\d+(?:\\.\\d+){0,2}) -g"
      ],
      "datasourceTemplate": "node-version",
      "depNameTemplate": "node",
      "versioningTemplate": "node"
    },
    {
      "customType": "regex",
      "description": "Keep hk Pkl package imports on the same release",
      "managerFilePatterns": ["/(^|/)hk\\.pkl$/"],
      "matchStrings": [
        "package://github\\.com/jdx/hk/releases/download/v(?<currentValue>\\d+\\.\\d+\\.\\d+)/hk@\\d+\\.\\d+\\.\\d+"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "jdx/hk",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v(?<version>.*)$",
      "autoReplaceStringTemplate": "package://github.com/jdx/hk/releases/download/v{{{newValue}}}/hk@{{{newValue}}}"
    }
  ],
  "packageRules": [
    {
      "description": "Batch tooling and infrastructure updates outside the project groups",
      "matchPackageNames": ["*"],
      "groupName": "tooling and infrastructure"
    },
    {
      "description": "Link Planetiler image updates to its source and commit history",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/onthegomap/planetiler"],
      "sourceUrl": "https://github.com/onthegomap/planetiler",
      "changelogUrl": "https://github.com/onthegomap/planetiler/commits/main/"
    },
    {
      "description": "Group all frontend/client dependencies",
      "matchFileNames": ["frontend/**"],
      "groupName": "frontend"
    },
    {
      "description": "Group all backend dependencies",
      "matchFileNames": ["backend/**"],
      "groupName": "backend"
    },
    {
      "description": "Group all science dependencies",
      "matchFileNames": ["science/**"],
      "groupName": "science"
    },
    {
      "description": "Update the hk executable and all Pkl imports together",
      "matchDepNames": ["jdx/hk", "aqua:jdx/hk"],
      "groupName": "hk"
    },
    {
      "description": "Combine lockfile maintenance across all projects instead of splitting by directory",
      "matchUpdateTypes": ["lockFileMaintenance"],
      "groupName": "all lockfiles"
    }
  ]
}
