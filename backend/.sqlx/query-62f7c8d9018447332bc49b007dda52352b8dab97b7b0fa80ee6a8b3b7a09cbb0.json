  "query": "\n        UPDATE realtime.trip AS t SET shape_ids = ARRAY[i.shape_id]::varchar[]\n        FROM UNNEST($1::uuid[], $2::text[]) AS i(trip_id, shape_id)\n        WHERE t.id = i.trip_id AND cardinality(t.shape_ids) = 0 RETURNING t.*\n    ",
