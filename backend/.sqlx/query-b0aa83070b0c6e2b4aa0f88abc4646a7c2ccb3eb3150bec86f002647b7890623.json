  "query": "\n            SELECT\n                s.id,\n                s.source,\n                a.geom,\n                s.data\n            FROM static.shape s JOIN static.shape_asset a ON(a.source, a.id) =(s.source, s.asset_id)\n            WHERE s.source = $1\n            AND s.current\n            ",
