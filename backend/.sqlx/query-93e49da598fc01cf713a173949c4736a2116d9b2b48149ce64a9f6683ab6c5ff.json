  "query": "\n            INSERT INTO static.shape_asset(source, id, geom)\n            SELECT\n                $1,\n                id,\n                ST_SetSRID(geom, 4326)\n            FROM UNNEST($2::text[], $3::geometry[]) AS i(id, geom)\n            ON CONFLICT(source, id) DO NOTHING\n            ",
