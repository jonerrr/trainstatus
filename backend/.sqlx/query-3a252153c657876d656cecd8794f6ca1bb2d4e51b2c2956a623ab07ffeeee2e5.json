  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                DISTINCT ON(run_id) run_id AS trip_id,\n                longitude,\n                latitude,\n                observed_at\n            FROM realtime.gps_sample\n            WHERE run_id = ANY($1)\n            AND observed_at BETWEEN($2::timestamptz - INTERVAL '5 minutes')\n            AND $2\n            ORDER BY run_id, observed_at DESC\n            ",
