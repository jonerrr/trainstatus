amends "package://github.com/jdx/hk/releases/download/v2.10.0/hk@2.10.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.10.0/hk@2.10.0#/Builtins.pkl"

local code = List("**/*.rs", "Cargo.toml", "Cargo.lock", "mise.toml", "migrations/**", ".sqlx/**", "protos/**", "tests/**")

steps {
  ["rustfmt"] = (Builtins.rustfmt) {
    check = "rustfmt --check --edition 2024 --config skip_children=true {{files}}"
    check_list_files = "rustfmt --check --edition 2024 --config skip_children=true --files-with-diff {{files}}"
    fix = "rustfmt --edition 2024 --config skip_children=true {{files}}"
  }
  ["lock"] {
    glob = code
    check = "cargo metadata --locked --format-version 1 > /dev/null"
  }
  ["clippy"] = (Builtins.cargo_clippy) {
    glob = code
    check = "cargo clippy --locked --all-targets --all-features -- -D warnings"
    fix = check
  }
  ["unit-tests"] {
    glob = code
    check = "mise run test:unit"
    depends = "clippy"
  }
  ["no-scoped-pub"] {
    glob = List("src/**/*.rs", "tests/**/*.rs")
    check = "! rg -n 'pub ?\\((crate|super|in )' {{files}}"
  }
  ["mise-format"] = Builtins.mise
}
